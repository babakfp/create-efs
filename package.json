{
    "name": "create-efs",
    "description": "A CLI tool to create SvelteKit apps.",
    "version": "1.7.3",
    "license": "MIT",
    "scripts": {
        "dev": "pnpm rmDist && tsc -w",
        "build": "pnpm rmDist && tsc",
        "format": "prettier --log-level=warn -w .",
        "prepublishOnly": "pnpm cleanTemplate && tsc",
        "cleanTemplate": "node -e \"const fs=require('fs');fs.globSync('templates/SvelteKit/{node_modules,.svelte-kit,static/error.css,vite.config.*.timestamp-*,pnpm-lock.yaml}').forEach(_ => fs.rmSync(_, { recursive: true, force: true }))\"",
        "rmDist": "node -e \"require('fs').rmSync('./dist', { recursive: true, force: true })\""
    },
    "dependencies": {
        "@clack/prompts": "^1.9.0",
        "node-stream-zip": "^1.16.0",
        "nodejs-file-downloader": "^4.13.0"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^26.6.6",
        "prettier": "^3.10.1",
        "typescript": "^6.0.3"
    },
    "repository": "github:babakfp/create-efs",
    "main": "./dist/index.js",
    "bin": "./dist/index.js",
    "files": [
        "./dist/",
        "./templates/"
    ],
    "exports": {
        ".": "./dist/index.js"
    },
    "keywords": [
        "cli",
        "svelte",
        "create",
        "template",
        "scaffold"
    ],
    "packageManager": "pnpm@12.21.0",
    "type": "module"
}
